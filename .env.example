# ─────────────────────────────────────────────────────────────────────────────
# Lumen — environment variables (documented; DO NOT put real secrets in this file)
# Copy to apps/web/.env.local and fill. Server-only vars (no NEXT_PUBLIC_) never
# reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── 0G Compute (server-only — the gateway holds this; never exposed to client) ──
# Two supported paths; ZG_PROVIDER_URL decides which one is active:
#   • DIRECT (what production runs): set ZG_PROVIDER_URL to a provider's own
#     endpoint and ZG_COMPUTE_API_KEY to a wallet-signed `app-sk-…` token
#     (`0g-compute-cli inference get-secret`). Requests go to
#     ${ZG_PROVIDER_URL}/v1/proxy. Note: an app-sk is locked to that ONE provider.
#   • ROUTER: leave ZG_PROVIDER_URL unset and use an `sk-…` key from
#     https://pc.0g.ai (wallet connect + small deposit). Auto-failover.
# If ZG_COMPUTE_API_KEY is unset, LOCAL DEV AND PREVIEWS run in clearly-labeled
# DEMO mode (a mock TEE stream) so the loop is always clickable. A PRODUCTION
# deploy in that state answers 503 instead — see mayServeDemo() in
# apps/web/lib/0g/env.ts. Serving a fabricated reflection to real users under a
# privacy promise is not something a label makes acceptable.
ZG_COMPUTE_API_KEY=
ZG_PROVIDER_URL=
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_COMPUTE_MODEL=glm-5.1

# ── 0G Voice — Whisper transcription (server-only, Wave 2) ─────────────────────
# Router `sk-` key (pc.0g.ai) for whisper-large-v3 via /v1/audio/transcriptions.
# Unset → the mic button is hidden and /api/transcribe answers 503 honestly.
ZG_VOICE_API_KEY=
ZG_VOICE_BASE_URL=https://router-api.0g.ai/v1
# ZG_VOICE_MODEL=whisper-large-v3        # override the speech model

# ── 0G inference registry (server-only, optional) ───────────────────────────────
# /api/tee-signer reads the provider's registered TEE signer from the on-chain
# InferenceServing registry, which lives on 0G MAINNET regardless of the app's
# network. Both have working defaults; override only to test another provider.
# ZG_COMPUTE_RPC=https://evmrpc.0g.ai
# ZG_PROVIDER_ADDRESS=0xDB7B465300B0acf454867683c5481055f698b2e8

# ── 0G network (client-safe) ────────────────────────────────────────────────────
# ONE build talks to ONE network: this moves the wallet chain, the upload RPC,
# the storage indexer and every explorer link together.
#   mainnet (default) = Aristotle, chain 16661 — REAL 0G; saves cost ~0.001 0G
#   testnet           = Galileo,   chain 16602 — free 0G from https://faucet.0g.ai
# NEXT_PUBLIC_* is inlined at BUILD time: changing this needs a rebuild, and the
# active network is shown permanently in the app header so it's never a guess.
# There is deliberately NO chainId override — a chainId belongs to a network.
NEXT_PUBLIC_ZG_NETWORK=mainnet

# Optional endpoint overrides, scoped per network so they can never cross
# (e.g. point mainnet at a different indexer without touching testnet).
# NEXT_PUBLIC_ZG_MAINNET_RPC=
# NEXT_PUBLIC_ZG_MAINNET_INDEXER_RPC=
# NEXT_PUBLIC_ZG_TESTNET_RPC=
# NEXT_PUBLIC_ZG_TESTNET_INDEXER_RPC=

# ── Wallet (client-safe) ────────────────────────────────────────────────────────
# WalletConnect / Reown project id (https://dashboard.walletconnect.com). Without
# a real one, mobile + QR wallet connections fail (the placeholder 403s).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Contracts (client-safe) ─────────────────────────────────────────────────────
# LumenCompanion (ERC-7857 INFT). Deployed + chainscan-verified on BOTH networks at
# 0x0FD618664FFAc86ef734C0C46eFF23bD73CBd738 — that address is the built-in default,
# so this only needs setting to point at a different deployment. If you DO
# override it, set NEXT_PUBLIC_LUMEN_INFT_DEPLOY_BLOCK too — the built-in
# start-block table is keyed by network, not by address, so without it the
# public proof page scans from the canonical deployment block, misses your
# mint, and reports an incomplete history for a companion that is fine.
NEXT_PUBLIC_LUMEN_INFT_ADDRESS=
# Block the overridden contract was deployed at. Only needed with the override above.
NEXT_PUBLIC_LUMEN_INFT_DEPLOY_BLOCK=
